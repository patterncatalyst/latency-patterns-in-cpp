# Jekyll
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Ruby / Bundler
vendor/
.bundle/
Gemfile.lock

# Python
__pycache__/
*.pyc
.venv/

# CMake / C++ build
build/
build-*/
out/
CMakeFiles/
CMakeCache.txt
cmake-build-*/

# C++ toolchain (user-space Clang/LLVM, CMake, Ninja; see scripts/bootstrap-toolchain.sh)
# Also covers .toolchain/rust/, the repo-local rustup/cargo install from
# scripts/bootstrap-rust.sh.
.toolchain/

# Conan
.conan/
conan.lock
CMakeUserPresets.json

# Cargo build output (examples/_rust-probe/ and later Rust-lane crates)
target/
**/target/

# Caches
.cache/
**/.cache/

# Editor / OS
.vscode/
.idea/
*.swp
*~
.DS_Store

# Results that may carry host-specific artifacts before scrubbing
examples/**/results/.raw/

# measure::init_logging() rotating file logs (see examples/_lib), written
# relative to the CWD a chapter's binary runs from, e.g. examples/NN-name/logs/
logs/
**/logs/
