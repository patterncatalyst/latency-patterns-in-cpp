# versions.env - the one place every pinned tool and library version lives.
#
# Every pin here is the exact upstream latest-stable release, surveyed at the
# date recorded next to it (see CLAUDE.md, "Dependencies"). Nothing here is a
# floating range. scripts/bootstrap-toolchain.sh and _plans/dependency-pins.md
# must stay in sync with this file; this file is the source of truth.
#
# The C++ toolchain (Clang/LLVM, CMake, Ninja) is a user-space install under
# .toolchain/, never the Fedora-packaged clang/cmake/ninja on the host PATH
# (see CLAUDE.md, "Dependencies": no Fedora-packaged toolchain on a measured
# path). Conan and its packages (GoogleTest, spdlog) are pinned exactly in
# conanfile.py; the versions below mirror those pins for a single lookup.

# --- C++ toolchain (user-space, unpacked by scripts/bootstrap-toolchain.sh) --
LLVM_VERSION=23.1.6        # surveyed 2026-11-24, upstream latest stable
CMAKE_VERSION=4.5.1        # surveyed 2026-11-24, upstream latest stable
NINJA_VERSION=1.13.2       # surveyed 2026-11-24, upstream latest stable
CONAN_VERSION=2.34.0       # surveyed 2026-11-24, upstream latest stable (PyPI)

# --- Conan-managed C++ libraries (pinned in conanfile.py) -------------------
GTEST_VERSION=1.18.0       # surveyed 2026-11-24, upstream latest stable
SPDLOG_VERSION=1.17.0      # surveyed 2026-11-24, upstream latest stable
